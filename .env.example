# Copy to .env and edit. Never commit .env.

# Required: the bearer token clients must send ("Authorization: Bearer <token>").
# Generate one with:  openssl rand -base64 24
MCPLOGVIEW_TOKEN=

# Where the port is published on the host. 127.0.0.1 = this machine only.
# 0.0.0.0 serves the network: read docs/docker.md ("Security") first; plain HTTP is not encrypted.
#MCPLOGVIEW_BIND=127.0.0.1
#MCPLOGVIEW_PORT=3333

# Host directories mounted into the container. Defaults are inside this repository.
#MCPLOGVIEW_LOGS=/var/log/myapp          # log files to expose, read-only at /logs
#MCPLOGVIEW_CONFIG=/srv/mcplogview/config # mcplogview.json + log-skills/
#MCPLOGVIEW_SSH_KEYS=/srv/mcplogview/keys # directory with ssh private keys, read-only at ~/.ssh/keys
#MCPLOGVIEW_KNOWN_HOSTS=/srv/mcplogview/known_hosts  # FILE (must exist), writable at ~/.ssh/known_hosts

# Linux: build the image with your own uid so keys/config you own are readable
# (needed for ssh keys). Run: MCPLOGVIEW_UID=$(id -u) docker compose up -d --build
#MCPLOGVIEW_UID=1000

#MCPLOGVIEW_VERSION=dev
